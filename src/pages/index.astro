---
// Pre-launch home. Replaced by the real homepage in Phase 2.
import { Button } from '../components/Button/Button';
import { SectionShell } from '../components/SectionShell/SectionShell';
import Base from '../layouts/Base.astro';
---
<Base
  title="Jarod Taylor · Engineering Leader, Design Engineering & Developer Experience"
  description="Jarod Taylor is a Frisco, TX engineering leader with 18 years in design systems, frontend platforms, and developer experience at Estée Lauder, JCPenney, and Aetna."
>
  <SectionShell title="Jarod Taylor" level={1}>
    <p>Engineering leader · Design engineer · Frisco, TX</p>
    <p><strong>I build the work behind the work.</strong></p>
    <p>
      Designer turned engineer turned engineering leader. For 18 years I've built design systems,
      frontend platforms, and developer experience that make whole engineering orgs faster, and led
      the teams that build them.
    </p>
    <p>
      This site is being built in the open, starting with its design tokens.
      <a href="https://github.com/jarodtaylor/jarodtaylor.com">Watch it come together on GitHub.</a>
    </p>
    <p>
      <Button href="mailto:contact@jarodtaylor.com">Let's talk</Button>{" "}
      <Button href="https://www.linkedin.com/in/jarodtaylor">LinkedIn</Button>
    </p>
  </SectionShell>
</Base>
