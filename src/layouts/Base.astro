---
import '../styles/global.css';
import layers from '../styles/layers.css?raw';
import fontsCss from '../styles/fonts.css?raw';
import resolver from '../../tokens/resolver.json';

interface Props {
  title: string;
  description: string;
  /** Keep internal pages (e.g. /lab) out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Person schema on every page: the main signal separating this Jarod Taylor from the others in search.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jarod Taylor',
  jobTitle: 'Engineering Leader',
  url: 'https://jarodtaylor.com/',
  address: { '@type': 'PostalAddress', addressLocality: 'Frisco', addressRegion: 'TX', addressCountry: 'US' },
  sameAs: [
    'https://www.linkedin.com/in/jarodtaylor',
    'https://x.com/jarodtaylor',
    'https://github.com/jarodtaylor',
  ],
};
const brand = resolver.modifiers.brand;
const brands = Object.keys(brand.contexts);
const canonical = new URL(Astro.url.pathname, Astro.site);
// The default brand's faces, fetched before the stylesheet asks for them (Remix brands load theirs on demand).
// Derived, so changing the default brand in resolver.json changes the preloads: the default's family knobs name
// the faces, and fonts.css's @font-face rules map each face to its file.
const knobFiles = import.meta.glob<{ type: { family: Record<string, { $value: string }> } }>('../../tokens/knobs/*.json', {
  eager: true,
  import: 'default',
});
const defaultFamilies = ['display', 'text', 'label'].map(
  (role) => knobFiles[`../../tokens/knobs/${brand.default}.json`]!.type.family[role]!.$value,
);
const faceFiles = [...fontsCss.matchAll(/@font-face\s*\{([^}]*)\}/g)].flatMap(([, rule]) => {
  const family = /font-family:\s*"([^"]+)"/.exec(rule!)?.[1];
  const file = /url\("\/fonts\/([\w-]+)\.woff2"\)/.exec(rule!)?.[1];
  return family && file ? [{ family, file }] : [];
});
const preloadFonts = [...new Set(defaultFamilies.map((f) => faceFiles.find((face) => face.family === f)?.file))].filter(Boolean);
---
<!doctype html>
<html lang="en" data-brand={brand.default}>
  <head>
    <meta charset="utf-8" />
    <style is:inline set:html={layers}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preloadFonts.map((face) => <link rel="preload" href={`/fonts/${face}.woff2`} as="font" type="font/woff2" crossorigin />)}
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Brand switch, before first paint: ?brand=<name> wins and is remembered for this tab (sessionStorage), so
         internal links keep the brand without a query string. Tokens do the rest. -->
    <script is:inline define:vars={{ brands }}>
      let brand = new URLSearchParams(location.search).get('brand');
      try {
        if (brands.includes(brand)) sessionStorage.setItem('jt-brand', brand);
        else brand = sessionStorage.getItem('jt-brand');
      } catch {}
      if (brands.includes(brand)) document.documentElement.dataset.brand = brand;
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Each page owns its <main id="main"> (the skip link's target), so a page can frame it, e.g. the home stage. -->
    <slot />
  </body>
</html>
