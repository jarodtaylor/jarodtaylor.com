{
  "$description": "Brand knobs: default. PLACEHOLDER values until the brand is designed in Phase 1. This file is the only thing a brand authors; scripts/derive.ts turns it into tokens/generated/default.json.",
  "color": {
    "ramp": {
      "$type": "number",
      "$description": "OKLCH ramps on the shared lightness ladder (steps 150…975 = L × 1000). hue in degrees; hue-shift in degrees per unit L away from peak; chroma is the peak chroma before sRGB clamping; peak is the L of peak chroma; taper is the falloff exponent (0 flat, 1 linear).",
      "neutral": {
        "$description": "Neutral ramp",
        "hue": { "$value": 250 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.012 },
        "peak": { "$value": 0.6 },
        "taper": { "$value": 1 }
      },
      "accent": {
        "$description": "Accent ramp",
        "hue": { "$value": 255 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.16 },
        "peak": { "$value": 0.6 },
        "taper": { "$value": 1 }
      },
      "guide": {
        "$description": "Figure guide lines (PLACEHOLDER)",
        "hue": { "$value": 232 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.1 },
        "peak": { "$value": 0.6 },
        "taper": { "$value": 1 }
      },
      "redline": {
        "$description": "Figure redlines (PLACEHOLDER)",
        "hue": { "$value": 20 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.2 },
        "peak": { "$value": 0.6 },
        "taper": { "$value": 1 }
      }
    },
    "role": {
      "$type": "color",
      "$description": "Which ramp step plays each color role. The semantic tier aliases these, so every brand defines the same role names.",
      "bg": { "$value": "{color.neutral.950}" },
      "text": { "$value": "{color.neutral.300}" }
    }
  },
  "type": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" }, "$description": "Body text size; step 0 of the type scale" },
    "ratio": { "$type": "number", "$value": 1.2, "$description": "Modular type scale ratio" },
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "text": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "label": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "display": { "$value": 700 },
      "text": { "$value": 400 },
      "label": { "$value": 400 }
    },
    "variation": {
      "$type": "string",
      "$description": "font-variation-settings per role: \"wdth\" 62, \"opsz\" 96, … or normal",
      "display": { "$value": "normal" },
      "text": { "$value": "normal" },
      "label": { "$value": "normal" }
    }
  },
  "space": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" }, "$description": "Spacing unit before density" },
    "density": { "$type": "number", "$value": 1, "$description": "Multiplier on every spacing step. Below 1 is tighter, above 1 is airier" }
  },
  "shape": {
    "radius": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" }, "$description": "Base corner radius" },
    "border-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" }, "$description": "Base border weight" }
  },
  "fluid": {
    "$type": "string",
    "$description": "Fluid sizes as CSS expressions (vw, svh, rem; clamp/min/max/calc). phone is below 48rem, wide above. Not exported to Figma.",
    "hero-display": {
      "$description": "Hero name size",
      "phone": { "$value": "clamp(2.5rem, 12vw, 4rem)" },
      "wide": { "$value": "min(8vw, 14svh)" }
    },
    "hero-lead": {
      "$description": "Hero tagline size",
      "phone": { "$value": "clamp(1.25rem, 5vw, 1.75rem)" },
      "wide": { "$value": "clamp(1.5rem, 1rem + 1vw, 2.5rem)" }
    },
    "hero-figure": {
      "$description": "Hero figure extent",
      "phone": { "$value": "80vw" },
      "wide": { "$value": "min(45vw, 70svh)" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 160, "unit": "ms" } },
      "base": { "$value": { "value": 240, "unit": "ms" } },
      "slow": { "$value": { "value": 560, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "in": { "$value": [0.55, 0, 0.75, 0] },
      "draw": { "$value": [0.65, 0, 0.25, 1] },
      "pop": { "$value": [0.3, 1.5, 0.6, 1] }
    }
  },
  "enum": {
    "$type": "string",
    "$description": "Enumerated knobs. Component CSS reacts with container style queries; derive() validates each against its list.",
    "decoration": { "$value": "rules", "$extensions": { "com.jarodtaylor.enum": ["rules", "none"] } },
    "hero-figure": { "$value": "construction", "$extensions": { "com.jarodtaylor.enum": ["construction", "isometric", "lattice"] } },
    "hero-layout": { "$value": "stack", "$extensions": { "com.jarodtaylor.enum": ["stack", "name-over-details"] } },
    "hero-intro": { "$value": "peek", "$extensions": { "com.jarodtaylor.enum": ["peek", "assemble", "none"] } },
    "nav-mode": { "$value": "toggle", "$extensions": { "com.jarodtaylor.enum": ["toggle", "wrap"] } },
    "hero-cue": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["none", "icon", "labelled"] } },
    "talk-style": { "$value": "pill-fill", "$extensions": { "com.jarodtaylor.enum": ["pill-fill", "outline"] } },
    "label-case": { "$value": "upper", "$extensions": { "com.jarodtaylor.enum": ["upper", "none"] } }
  }
}
