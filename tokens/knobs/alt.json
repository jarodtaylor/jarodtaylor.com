{
  "$description": "Brand knobs: alt. PLACEHOLDER brand that exists to prove Remix differs in more than color (type, scale, density, shape, decoration).",
  "color": {
    "neutral": {
      "hue": { "$type": "number", "$value": 70, "$description": "OKLCH hue (degrees) of the neutral ramp" },
      "chroma": { "$type": "number", "$value": 0.02, "$description": "OKLCH chroma of the neutral ramp" }
    },
    "accent": {
      "hue": { "$type": "number", "$value": 30, "$description": "OKLCH hue (degrees) of the accent ramp" },
      "chroma": { "$type": "number", "$value": 0.14, "$description": "Peak OKLCH chroma of the accent ramp, before gamut clamping" }
    }
  },
  "type": {
    "base": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" }, "$description": "Body text size; step 0 of the type scale" },
    "ratio": { "$type": "number", "$value": 1.333, "$description": "Modular type scale ratio" },
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Didot", "Bodoni MT", "Georgia", "serif"] },
      "text": { "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "serif"] },
      "label": { "$value": ["Courier New", "Courier", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "display": { "$value": 400 },
      "text": { "$value": 400 },
      "label": { "$value": 400 }
    },
    "variation": {
      "$type": "string",
      "$description": "font-variation-settings per role: \"wdth\" 62, \"opsz\" 96, … or normal",
      "display": { "$value": "normal" },
      "text": { "$value": "normal" },
      "label": { "$value": "normal" }
    }
  },
  "space": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" }, "$description": "Spacing unit before density" },
    "density": { "$type": "number", "$value": 1.5, "$description": "Multiplier on every spacing step. Below 1 is tighter, above 1 is airier" }
  },
  "shape": {
    "radius": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" }, "$description": "Base corner radius" },
    "border-width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$description": "Base border weight" }
  },
  "fluid": {
    "$type": "string",
    "$description": "Fluid sizes as CSS expressions (vw, svh, rem; clamp/min/max/calc). phone is below 48rem, wide above. Not exported to Figma.",
    "hero-display": {
      "$description": "Hero name size",
      "phone": { "$value": "clamp(2.5rem, 12vw, 4rem)" },
      "wide": { "$value": "min(8vw, 14svh)" }
    },
    "hero-lead": {
      "$description": "Hero tagline size",
      "phone": { "$value": "clamp(1.25rem, 5vw, 1.75rem)" },
      "wide": { "$value": "clamp(1.5rem, 1rem + 1vw, 2.5rem)" }
    },
    "hero-figure": {
      "$description": "Hero figure extent",
      "phone": { "$value": "80vw" },
      "wide": { "$value": "min(45vw, 70svh)" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 160, "unit": "ms" } },
      "base": { "$value": { "value": 240, "unit": "ms" } },
      "slow": { "$value": { "value": 560, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "in": { "$value": [0.55, 0, 0.75, 0] },
      "draw": { "$value": [0.65, 0, 0.25, 1] },
      "pop": { "$value": [0.3, 1.5, 0.6, 1] }
    }
  },
  "enum": {
    "$type": "string",
    "$description": "Enumerated knobs. Component CSS reacts with container style queries; derive() validates each against its list.",
    "decoration": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["rules", "none"] } },
    "hero-figure": { "$value": "lattice", "$extensions": { "com.jarodtaylor.enum": ["construction", "isometric", "lattice"] } },
    "hero-layout": { "$value": "name-over-details", "$extensions": { "com.jarodtaylor.enum": ["stack", "name-over-details"] } },
    "hero-intro": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["peek", "assemble", "none"] } },
    "nav-mode": { "$value": "wrap", "$extensions": { "com.jarodtaylor.enum": ["toggle", "wrap"] } },
    "hero-cue": { "$value": "labelled", "$extensions": { "com.jarodtaylor.enum": ["none", "icon", "labelled"] } },
    "talk-style": { "$value": "outline", "$extensions": { "com.jarodtaylor.enum": ["pill-fill", "outline"] } },
    "label-case": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["upper", "none"] } }
  }
}
