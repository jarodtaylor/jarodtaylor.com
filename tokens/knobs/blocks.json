{
  "$description": "Brand knobs: blocks (Building blocks, prototypes/r6-blocks). The only thing a brand authors; scripts/derive.ts turns it into tokens/generated/blocks.json. Colours were fitted to the prototype (scripts/fixtures/prototype-colors.json).",
  "color": {
    "ramp": {
      "$type": "number",
      "neutral": {
        "hue": { "$value": 266.1 },
        "hue-shift": { "$value": -0.9 },
        "chroma": { "$value": 0.209 },
        "peak": { "$value": 0.396 },
        "taper": { "$value": 1.06 }
      },
      "accent": {
        "hue": { "$value": 41.1 },
        "hue-shift": { "$value": 27 },
        "chroma": { "$value": 0.195 },
        "peak": { "$value": 0.763 },
        "taper": { "$value": 0.48 }
      },
      "guide": {
        "hue": { "$value": 232 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.1 },
        "peak": { "$value": 0.6 },
        "taper": { "$value": 1 }
      },
      "redline": {
        "hue": { "$value": 20 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.2 },
        "peak": { "$value": 0.75 },
        "taper": { "$value": 1.2 }
      }
    },
    "role": {
      "$type": "color",
      "bg": { "$value": "{color.neutral.400}" },
      "bg-next": { "$value": "{color.neutral.350}" },
      "text": { "$value": "{color.neutral.975}" },
      "text-muted": { "$value": "{color.neutral.850}" },
      "text-body": { "$value": "{color.neutral.850}" },
      "text-quiet": { "$value": "{color.neutral.800}" },
      "rule": { "$value": "{color.neutral.525}" },
      "rule-strong": { "$value": "{color.neutral.650}" },
      "accent": { "$value": "{color.accent.675}" },
      "on-accent": { "$value": "{color.neutral.275}" },
      "accent-text": { "$value": "{color.accent.775}" },
      "focus": { "$value": "{color.accent.775}" },
      "figure-line": { "$value": "{color.neutral.975}" },
      "figure-mark": { "$value": "{color.accent.675}" },
      "figure-mark-light": { "$value": "{color.accent.600}" },
      "figure-mark-dark": { "$value": "{color.accent.500}" },
      "figure-face": { "$value": "{color.neutral.975}" },
      "figure-face-light": { "$value": "{color.neutral.850}" },
      "figure-face-dark": { "$value": "{color.neutral.750}" },
      "figure-edge": { "$value": "{color.neutral.275}" },
      "figure-guide": { "$value": "{color.guide.675}" },
      "figure-guide-ink": { "$value": "{color.guide.750}" },
      "figure-redline": { "$value": "{color.redline.700}" },
      "figure-on-redline": { "$value": "{color.redline.175}" }
    }
  },
  "type": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "ratio": { "$type": "number", "$value": 1.25 },
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "Bricolage Grotesque Fallback", "Arial Narrow", "sans-serif"] },
      "text": { "$value": ["Atkinson Hyperlegible Next", "Atkinson Hyperlegible Next Fallback", "Helvetica Neue", "sans-serif"] },
      "label": { "$value": ["Atkinson Hyperlegible Next", "Atkinson Hyperlegible Next Fallback", "Helvetica Neue", "sans-serif"] },
      "lead": { "$value": "{font.family.display}" },
      "control": { "$value": "{font.family.text}" }
    },
    "weight": {
      "$type": "fontWeight",
      "display": { "$value": 800 },
      "text": { "$value": 400 },
      "label": { "$value": 600 },
      "lead": { "$value": 700 },
      "control": { "$value": 700 }
    },
    "variation": {
      "$type": "string",
      "display": { "$value": "\"wdth\" 86, \"opsz\" 96" },
      "text": { "$value": "normal" },
      "label": { "$value": "normal" },
      "lead": { "$value": "\"wdth\" 86, \"opsz\" 96" },
      "control": { "$value": "normal" }
    },
    "leading": {
      "$type": "number",
      "$description": "Unitless line-height per type role",
      "display": { "$value": 0.88 },
      "text": { "$value": 1.5 },
      "label": { "$value": 1.3 },
      "lead": { "$value": 1.08 },
      "control": { "$value": 1 }
    },
    "tracking": {
      "$type": "string",
      "$description": "letter-spacing per type role: 0 or an em length",
      "display": { "$value": "-0.035em" },
      "text": { "$value": "0" },
      "label": { "$value": "0.02em" },
      "lead": { "$value": "-0.015em" },
      "control": { "$value": "0" }
    }
  },
  "space": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "density": { "$type": "number", "$value": 1 }
  },
  "shape": {
    "radius": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } },
    "border-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } }
  },
  "fluid": {
    "$type": "string",
    "page-x": {
      "phone": { "$value": "clamp(1.25rem, 4vw, 7rem)" },
      "wide": { "$value": "clamp(1.25rem, 4vw, 7rem)" }
    },
    "col-gap": {
      "phone": { "$value": "clamp(1.25rem, 0.85rem + 0.75vw, 2.25rem)" },
      "wide": { "$value": "clamp(1.25rem, 0.85rem + 0.75vw, 2.25rem)" }
    },
    "header-h": {
      "phone": { "$value": "clamp(3.75rem, 3rem + 1.4vw, 5.5rem)" },
      "wide": { "$value": "clamp(3.75rem, 3rem + 1.4vw, 5.5rem)" }
    },
    "control-h": {
      "phone": { "$value": "2.75rem" },
      "wide": { "$value": "2.75rem" }
    },
    "rhythm": {
      "phone": { "$value": "clamp(1.25rem, 0.85rem + 0.75vw, 2.25rem)" },
      "wide": { "$value": "clamp(1.25rem, 0.85rem + 0.75vw, 2.25rem)" }
    },
    "stage-h": {
      "phone": { "$value": "100svh" },
      "wide": { "$value": "100svh" }
    },
    "mark-header": {
      "phone": { "$value": "clamp(1.625rem, 1.3rem + 0.6vw, 2.5rem)" },
      "wide": { "$value": "clamp(1.625rem, 1.3rem + 0.6vw, 2.5rem)" }
    },
    "text-body": {
      "phone": { "$value": "clamp(1.0625rem, 0.78rem + 0.42vw, 1.45rem)" },
      "wide": { "$value": "clamp(1.0625rem, 0.78rem + 0.42vw, 1.45rem)" }
    },
    "text-label": {
      "phone": { "$value": "clamp(0.8125rem, 0.68rem + 0.22vw, 1.0625rem)" },
      "wide": { "$value": "clamp(0.8125rem, 0.68rem + 0.22vw, 1.0625rem)" }
    },
    "text-small": {
      "phone": { "$value": "clamp(0.75rem, 0.68rem + 0.12vw, 0.9375rem)" },
      "wide": { "$value": "clamp(0.75rem, 0.68rem + 0.12vw, 0.9375rem)" }
    },
    "measure": {
      "phone": { "$value": "46ch" },
      "wide": { "$value": "46ch" }
    },
    "hero-display": {
      "phone": { "$value": "max(3.5rem, min(9.6vw, 19svh))" },
      "wide": { "$value": "max(3.5rem, min(9.6vw, 19svh))" }
    },
    "hero-lead": {
      "phone": { "$value": "clamp(1.5rem, 0.95rem + 1.5vw, 3.4rem)" },
      "wide": { "$value": "clamp(1.5rem, 0.95rem + 1.5vw, 3.4rem)" }
    },
    "hero-figure": {
      "phone": { "$value": "90vw" },
      "wide": { "$value": "54vw" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "beat": { "$value": { "value": 100, "unit": "ms" } },
      "fast": { "$value": { "value": 160, "unit": "ms" } },
      "base": { "$value": { "value": 300, "unit": "ms" } },
      "slow": { "$value": { "value": 760, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "in": { "$value": [0.5, 0, 0.75, 0] },
      "draw": { "$value": [0.22, 0.7, 0.2, 1] },
      "pop": { "$value": [0.3, 1.5, 0.6, 1] }
    }
  },
  "enum": {
    "$type": "string",
    "decoration": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["rules", "none"] } },
    "hero-figure": { "$value": "isometric", "$extensions": { "com.jarodtaylor.enum": ["construction", "isometric", "lattice"] } },
    "hero-layout": { "$value": "stack", "$extensions": { "com.jarodtaylor.enum": ["stack", "name-over-details"] } },
    "hero-intro": { "$value": "assemble", "$extensions": { "com.jarodtaylor.enum": ["peek", "assemble", "none"] } },
    "nav-mode": { "$value": "toggle", "$extensions": { "com.jarodtaylor.enum": ["toggle", "wrap"] } },
    "hero-cue": { "$value": "icon", "$extensions": { "com.jarodtaylor.enum": ["none", "icon", "labelled"] } },
    "talk-style": { "$value": "pill-fill", "$extensions": { "com.jarodtaylor.enum": ["pill-fill", "outline"] } },
    "label-case": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["upper", "none"] } }
  }
}
