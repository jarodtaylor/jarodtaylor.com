{
  "$description": "Brand knobs: clean (Clean and sharp, prototypes/r6-clean). The only thing a brand authors; scripts/derive.ts turns it into tokens/generated/clean.json. Colours were fitted to the prototype (scripts/fixtures/prototype-colors.json).",
  "color": {
    "ramp": {
      "$type": "number",
      "neutral": {
        "hue": { "$value": 170.8 },
        "hue-shift": { "$value": -4.8 },
        "chroma": { "$value": 0.074 },
        "peak": { "$value": 0.228 },
        "taper": { "$value": 0.49 }
      },
      "accent": {
        "hue": { "$value": 53.1 },
        "hue-shift": { "$value": 28 },
        "chroma": { "$value": 0.124 },
        "peak": { "$value": 0.82 },
        "taper": { "$value": 0.29 }
      },
      "guide": {
        "hue": { "$value": 232 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.1 },
        "peak": { "$value": 0.6 },
        "taper": { "$value": 1 }
      },
      "redline": {
        "hue": { "$value": 20 },
        "hue-shift": { "$value": 0 },
        "chroma": { "$value": 0.2 },
        "peak": { "$value": 0.75 },
        "taper": { "$value": 1.2 }
      }
    },
    "role": {
      "$type": "color",
      "bg": { "$value": "{color.neutral.275}" },
      "bg-next": { "$value": "{color.neutral.250}" },
      "text": { "$value": "{color.neutral.975}" },
      "text-muted": { "$value": "{color.neutral.850}" },
      "text-body": { "$value": "{color.neutral.850}" },
      "text-quiet": { "$value": "{color.neutral.850}" },
      "rule": { "$value": "{color.neutral.475}" },
      "rule-strong": { "$value": "{color.neutral.600}" },
      "accent": { "$value": "{color.accent.800}" },
      "on-accent": { "$value": "{color.neutral.250}" },
      "accent-text": { "$value": "{color.accent.800}" },
      "focus": { "$value": "{color.accent.800}" },
      "figure-line": { "$value": "{color.neutral.975}" },
      "figure-mark": { "$value": "{color.accent.800}" },
      "figure-mark-light": { "$value": "{color.accent.700}" },
      "figure-mark-dark": { "$value": "{color.accent.600}" },
      "figure-face": { "$value": "{color.neutral.975}" },
      "figure-face-light": { "$value": "{color.neutral.850}" },
      "figure-face-dark": { "$value": "{color.neutral.750}" },
      "figure-edge": { "$value": "{color.neutral.200}" },
      "figure-guide": { "$value": "{color.guide.675}" },
      "figure-guide-ink": { "$value": "{color.guide.750}" },
      "figure-redline": { "$value": "{color.redline.700}" },
      "figure-on-redline": { "$value": "{color.redline.175}" }
    }
  },
  "type": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "ratio": { "$type": "number", "$value": 1.25 },
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Funnel Display", "Funnel Display Fallback", "ui-sans-serif", "system-ui", "sans-serif"] },
      "text": { "$value": ["Funnel Sans", "Funnel Sans Fallback", "ui-sans-serif", "system-ui", "sans-serif"] },
      "label": { "$value": ["Funnel Sans", "Funnel Sans Fallback", "ui-sans-serif", "system-ui", "sans-serif"] },
      "lead": { "$value": "{font.family.display}" },
      "control": { "$value": "{font.family.label}" }
    },
    "weight": {
      "$type": "fontWeight",
      "display": { "$value": 560 },
      "text": { "$value": 380 },
      "label": { "$value": 500 },
      "lead": { "$value": 420 },
      "control": { "$value": 500 }
    },
    "variation": {
      "$type": "string",
      "display": { "$value": "normal" },
      "text": { "$value": "normal" },
      "label": { "$value": "normal" },
      "lead": { "$value": "normal" },
      "control": { "$value": "normal" }
    },
    "leading": {
      "$type": "number",
      "$description": "Unitless line-height per type role",
      "display": { "$value": 0.84 },
      "text": { "$value": 1.5 },
      "label": { "$value": 1.3 },
      "lead": { "$value": 1.12 },
      "control": { "$value": 1.3 }
    },
    "tracking": {
      "$type": "string",
      "$description": "letter-spacing per type role: 0 or an em length",
      "display": { "$value": "-0.04em" },
      "text": { "$value": "0" },
      "label": { "$value": "0" },
      "lead": { "$value": "-0.015em" },
      "control": { "$value": "0" }
    }
  },
  "space": {
    "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "density": { "$type": "number", "$value": 1 }
  },
  "shape": {
    "radius": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } },
    "border-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } }
  },
  "fluid": {
    "$type": "string",
    "page-x": {
      "phone": { "$value": "clamp(1rem, 0.4rem + 2.6vw, 4rem)" },
      "wide": { "$value": "clamp(1rem, 0.4rem + 2.6vw, 4rem)" }
    },
    "col-gap": {
      "phone": { "$value": "clamp(1.25rem, 0.8rem + 1.6vw, 3.5rem)" },
      "wide": { "$value": "clamp(1.25rem, 0.8rem + 1.6vw, 3.5rem)" }
    },
    "header-h": {
      "phone": { "$value": "clamp(3.5rem, 2.75rem + 1.2vw, 5rem)" },
      "wide": { "$value": "clamp(3.5rem, 2.75rem + 1.2vw, 5rem)" }
    },
    "control-h": {
      "phone": { "$value": "clamp(2.25rem, 1.9rem + 0.5vw, 2.75rem)" },
      "wide": { "$value": "clamp(2.25rem, 1.9rem + 0.5vw, 2.75rem)" }
    },
    "rhythm": {
      "phone": { "$value": "clamp(1.25rem, 0.8rem + 1vw, 2.25rem)" },
      "wide": { "$value": "clamp(1.25rem, 0.8rem + 1vw, 2.25rem)" }
    },
    "stage-h": {
      "phone": { "$value": "100svh" },
      "wide": { "$value": "100svh" }
    },
    "mark-header": {
      "phone": { "$value": "clamp(1.75rem, 1.4rem + 0.6vw, 2.5rem)" },
      "wide": { "$value": "clamp(1.75rem, 1.4rem + 0.6vw, 2.5rem)" }
    },
    "text-body": {
      "phone": { "$value": "clamp(1.0625rem, 0.85rem + 0.5vw, 1.625rem)" },
      "wide": { "$value": "clamp(1.0625rem, 0.85rem + 0.5vw, 1.625rem)" }
    },
    "text-label": {
      "phone": { "$value": "clamp(0.8125rem, 0.72rem + 0.22vw, 1.0625rem)" },
      "wide": { "$value": "clamp(0.8125rem, 0.72rem + 0.22vw, 1.0625rem)" }
    },
    "text-small": {
      "phone": { "$value": "clamp(0.75rem, 0.68rem + 0.16vw, 0.9375rem)" },
      "wide": { "$value": "clamp(0.75rem, 0.68rem + 0.16vw, 0.9375rem)" }
    },
    "measure": {
      "phone": { "$value": "36em" },
      "wide": { "$value": "36em" }
    },
    "hero-display": {
      "phone": { "$value": "clamp(4.5rem, 0.6rem + 16.4vw, 32rem)" },
      "wide": { "$value": "clamp(4.5rem, 0.6rem + 16.4vw, 32rem)" }
    },
    "hero-lead": {
      "phone": { "$value": "clamp(1.5rem, 0.9rem + 1.6vw, 3.5rem)" },
      "wide": { "$value": "clamp(1.5rem, 0.9rem + 1.6vw, 3.5rem)" }
    },
    "hero-figure": {
      "phone": { "$value": "100vw" },
      "wide": { "$value": "100vw" }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "beat": { "$value": { "value": 100, "unit": "ms" } },
      "fast": { "$value": { "value": 160, "unit": "ms" } },
      "base": { "$value": { "value": 240, "unit": "ms" } },
      "slow": { "$value": { "value": 480, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "in": { "$value": [0.55, 0, 0.75, 0] },
      "draw": { "$value": [0.65, 0, 0.25, 1] },
      "pop": { "$value": [0.3, 1.5, 0.6, 1] }
    }
  },
  "enum": {
    "$type": "string",
    "decoration": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["rules", "none"] } },
    "hero-figure": { "$value": "lattice", "$extensions": { "com.jarodtaylor.enum": ["construction", "isometric", "lattice"] } },
    "hero-layout": { "$value": "name-over-details", "$extensions": { "com.jarodtaylor.enum": ["stack", "name-over-details"] } },
    "hero-intro": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["peek", "assemble", "none"] } },
    "nav-mode": { "$value": "wrap", "$extensions": { "com.jarodtaylor.enum": ["toggle", "wrap"] } },
    "hero-cue": { "$value": "labelled", "$extensions": { "com.jarodtaylor.enum": ["none", "icon", "labelled"] } },
    "talk-style": { "$value": "outline", "$extensions": { "com.jarodtaylor.enum": ["pill-fill", "outline"] } },
    "label-case": { "$value": "none", "$extensions": { "com.jarodtaylor.enum": ["upper", "none"] } }
  }
}
