{
  "header": {
    "bg": {
      "$type": "color",
      "$value": "{surface.default.bg}"
    },
    "text": {
      "$type": "color",
      "$value": "{surface.default.text}"
    },
    "rule": {
      "$type": "color",
      "$value": "{surface.default.border}"
    },
    "nav-mode": {
      "$type": "string",
      "$value": "{choice.nav-mode}"
    },
    "mark-size": {
      "$type": "string",
      "$value": "{layout.mark-header-phone}"
    },
    "mark-size-wide": {
      "$type": "string",
      "$value": "{layout.mark-header-wide}"
    },
    "control": {
      "$description": "Nav links, the menu and Peek buttons. label-case (upper | none) is read by a style query.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{type.family.control}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{type.weight.control}"
      },
      "font-variation": {
        "$type": "string",
        "$value": "{type.variation.control}"
      },
      "leading": {
        "$type": "number",
        "$value": "{type.leading.control}"
      },
      "tracking": {
        "$type": "string",
        "$value": "{type.tracking.control}"
      },
      "font-size": {
        "$type": "string",
        "$value": "{type.fluid.control-phone}"
      },
      "font-size-wide": {
        "$type": "string",
        "$value": "{type.fluid.control-wide}"
      },
      "label-case": {
        "$type": "string",
        "$value": "{choice.label-case}"
      },
      "muted": {
        "$type": "color",
        "$value": "{surface.default.text-quiet}"
      },
      "border": {
        "$type": "color",
        "$value": "{line.strong}"
      },
      "nav-weight": {
        "$type": "fontWeight",
        "$value": "{type.weight.nav}"
      }
    },
    "info": {
      "$description": "The info strip: role, location, status",
      "text": {
        "$type": "color",
        "$value": "{surface.default.text-muted}"
      },
      "status": {
        "$type": "color",
        "$value": "{surface.default.accent}"
      },
      "font-family": {
        "$type": "fontFamily",
        "$value": "{type.family.label}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{type.weight.text}"
      },
      "font-variation": {
        "$type": "string",
        "$value": "{type.variation.label}"
      },
      "font-size": {
        "$type": "string",
        "$value": "{type.fluid.small-phone}"
      },
      "tracking": {
        "$type": "string",
        "$value": "{type.tracking.label}"
      },
      "font-size-wide": {
        "$type": "string",
        "$value": "{type.fluid.small-wide}"
      },
      "sep": {
        "$type": "color",
        "$value": "{surface.default.separator}"
      },
      "layout": {
        "$type": "string",
        "$value": "{choice.info-layout}"
      },
      "rule-bleed": {
        "$type": "string",
        "$value": "{layout.rule-bleed-phone}"
      },
      "rule-bleed-wide": {
        "$type": "string",
        "$value": "{layout.rule-bleed-wide}"
      }
    },
    "menu": {
      "$description": "The phone nav popover",
      "bg": {
        "$type": "color",
        "$value": "{surface.raised.bg}"
      },
      "text": {
        "$type": "color",
        "$value": "{surface.raised.text}"
      },
      "border": {
        "$type": "color",
        "$value": "{surface.raised.border}"
      }
    },
    "nav-align": {
      "$type": "string",
      "$value": "{choice.nav-align}"
    },
    "menu-label": {
      "$type": "string",
      "$value": "{choice.menu-label}"
    }
  },
  "talk": {
    "$description": "The Let's talk button. talk-style picks pill-fill (accent fill) or outline (text-colored border; fills with accent on hover)",
    "style": {
      "$type": "string",
      "$value": "{choice.talk-style}"
    },
    "bg": {
      "$type": "color",
      "$value": "{surface.accent.bg}"
    },
    "text": {
      "$type": "color",
      "$value": "{surface.accent.text}"
    },
    "outline-text": {
      "$type": "color",
      "$value": "{surface.default.text}"
    },
    "outline-border": {
      "$type": "color",
      "$value": "{surface.default.text}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{shape.radius.pill}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{shape.border-width.default}"
    },
    "font-family": {
      "$type": "fontFamily",
      "$value": "{type.family.control}"
    },
    "font-weight": {
      "$type": "fontWeight",
      "$value": "{type.weight.control}"
    },
    "font-size": {
      "$type": "string",
      "$value": "{type.fluid.control-phone}"
    },
    "tracking": {
      "$type": "string",
      "$value": "{type.tracking.control}"
    },
    "duration": {
      "$type": "duration",
      "$value": "{motion.duration.fast}"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "{motion.easing.out}"
    },
    "font-size-wide": {
      "$type": "string",
      "$value": "{type.fluid.control-wide}"
    },
    "outline-radius": {
      "$type": "dimension",
      "$value": "{shape.radius.control}"
    }
  }
}
