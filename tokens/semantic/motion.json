{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.fast}"
      },
      "base": {
        "$value": "{duration.base}"
      },
      "slow": {
        "$value": "{duration.slow}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": "{easing.out}"
      },
      "in": {
        "$value": "{easing.in}"
      },
      "draw": {
        "$value": "{easing.draw}"
      },
      "pop": {
        "$value": "{easing.pop}"
      }
    }
  }
}
