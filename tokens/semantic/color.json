{
  "surface": {
    "$type": "color",
    "$description": "Surface roles. Each role declares the foregrounds used on it, so every pair a contrast check needs sits side by side. focus is the focus indicator on that surface (3:1, SC 1.4.11).",
    "default": {
      "bg": {
        "$value": "{color.neutral.50}"
      },
      "text": {
        "$value": "{color.neutral.900}"
      },
      "text-muted": {
        "$value": "{color.neutral.600}"
      },
      "border": {
        "$value": "{color.neutral.200}"
      },
      "link": {
        "$value": "{color.accent.700}"
      },
      "focus": {
        "$value": "{color.accent.500}"
      }
    },
    "raised": {
      "bg": {
        "$value": "{color.neutral.0}"
      },
      "text": {
        "$value": "{color.neutral.900}"
      },
      "text-muted": {
        "$value": "{color.neutral.600}"
      },
      "border": {
        "$value": "{color.neutral.200}"
      },
      "link": {
        "$value": "{color.accent.700}"
      },
      "focus": {
        "$value": "{color.accent.500}"
      }
    },
    "inverse": {
      "bg": {
        "$value": "{color.neutral.900}"
      },
      "text": {
        "$value": "{color.neutral.50}"
      },
      "text-muted": {
        "$value": "{color.neutral.300}"
      },
      "border": {
        "$value": "{color.neutral.700}"
      },
      "link": {
        "$value": "{color.accent.300}"
      },
      "focus": {
        "$value": "{color.accent.500}"
      }
    },
    "accent": {
      "bg": {
        "$value": "{color.accent.700}"
      },
      "text": {
        "$value": "{color.neutral.0}"
      },
      "text-muted": {
        "$value": "{color.accent.100}"
      },
      "border": {
        "$value": "{color.accent.500}"
      },
      "link": {
        "$value": "{color.neutral.0}"
      },
      "focus": {
        "$value": "{color.neutral.0}"
      }
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "$value": "{color.accent.500}"
    }
