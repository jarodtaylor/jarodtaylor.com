{
  "type": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": "{font.family.display}"
      },
      "text": {
        "$value": "{font.family.text}"
      },
      "label": {
        "$value": "{font.family.label}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "display": {
        "$value": "{font.weight.display}"
      },
      "text": {
        "$value": "{font.weight.text}"
      },
      "label": {
        "$value": "{font.weight.label}"
      }
    },
    "variation": {
      "$type": "string",
      "$description": "font-variation-settings for each role: axes such as wdth and opsz, or normal.",
      "display": {
        "$value": "{font.variation.display}"
      },
      "text": {
        "$value": "{font.variation.text}"
      },
      "label": {
        "$value": "{font.variation.label}"
      }
    },
    "size": {
      "$type": "dimension",
      "small": {
        "$value": "{font.size.sm}"
      },
      "body": {
        "$value": "{font.size.md}"
      },
      "lead": {
        "$value": "{font.size.lg}"
      },
      "h3": {
        "$value": "{font.size.xl}"
      },
      "h2": {
        "$value": "{font.size.2xl}"
      },
      "h1": {
        "$value": "{font.size.4xl}"
      },
      "display": {
        "$value": "{font.size.5xl}"
      }
    },
    "leading": {
      "$type": "number",
      "body": {
        "$value": "{font.line-height.normal}"
      },
      "snug": {
        "$value": "{font.line-height.snug}"
      },
      "heading": {
        "$value": "{font.line-height.tight}"
      }
    }
  }
}
