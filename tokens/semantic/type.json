{
  "type": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": "{font.family.display}"
      },
      "text": {
        "$value": "{font.family.text}"
      },
      "label": {
        "$value": "{font.family.label}"
      },
      "lead": {
        "$value": "{font.family.lead}"
      },
      "control": {
        "$value": "{font.family.control}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "display": {
        "$value": "{font.weight.display}"
      },
      "text": {
        "$value": "{font.weight.text}"
      },
      "label": {
        "$value": "{font.weight.label}"
      },
      "lead": {
        "$value": "{font.weight.lead}"
      },
      "control": {
        "$value": "{font.weight.control}"
      },
      "nav": {
        "$value": "{font.weight.nav}"
      }
    },
    "variation": {
      "$type": "string",
      "$description": "font-variation-settings for each role: axes such as wdth and opsz, or normal.",
      "display": {
        "$value": "{font.variation.display}"
      },
      "text": {
        "$value": "{font.variation.text}"
      },
      "label": {
        "$value": "{font.variation.label}"
      },
      "lead": {
        "$value": "{font.variation.lead}"
      },
      "control": {
        "$value": "{font.variation.control}"
      }
    },
    "size": {
      "$type": "dimension",
      "small": {
        "$value": "{font.size.sm}"
      },
      "body": {
        "$value": "{font.size.md}"
      },
      "lead": {
        "$value": "{font.size.lg}"
      },
      "h3": {
        "$value": "{font.size.xl}"
      },
      "h2": {
        "$value": "{font.size.2xl}"
      },
      "h1": {
        "$value": "{font.size.4xl}"
      },
      "display": {
        "$value": "{font.size.5xl}"
      }
    },
    "leading": {
      "$type": "number",
      "body": {
        "$value": "{font.leading.text}"
      },
      "snug": {
        "$value": "{font.line-height.snug}"
      },
      "heading": {
        "$value": "{font.line-height.tight}"
      },
      "display": {
        "$value": "{font.leading.display}"
      },
      "label": {
        "$value": "{font.leading.label}"
      },
      "lead": {
        "$value": "{font.leading.lead}"
      },
      "control": {
        "$value": "{font.leading.control}"
      }
    },
    "tracking": {
      "$type": "string",
      "$description": "letter-spacing per type role.",
      "display": {
        "$value": "{font.tracking.display}"
      },
      "text": {
        "$value": "{font.tracking.text}"
      },
      "label": {
        "$value": "{font.tracking.label}"
      },
      "lead": {
        "$value": "{font.tracking.lead}"
      },
      "control": {
        "$value": "{font.tracking.control}"
      }
    },
    "fluid": {
      "$type": "string",
      "$description": "Fluid type: phone below 48rem, wide above. display and lead are the hero name and tagline; body, label (controls and socials) and small (info strip, annotations) are the small steps.",
      "display-phone": {
        "$value": "{fluid.hero-display.phone}"
      },
      "display-wide": {
        "$value": "{fluid.hero-display.wide}"
      },
      "lead-phone": {
        "$value": "{fluid.hero-lead.phone}"
      },
      "lead-wide": {
        "$value": "{fluid.hero-lead.wide}"
      },
      "body-phone": {
        "$value": "{fluid.text-body.phone}"
      },
      "body-wide": {
        "$value": "{fluid.text-body.wide}"
      },
      "label-phone": {
        "$value": "{fluid.text-label.phone}"
      },
      "label-wide": {
        "$value": "{fluid.text-label.wide}"
      },
      "small-phone": {
        "$value": "{fluid.text-small.phone}"
      },
      "small-wide": {
        "$value": "{fluid.text-small.wide}"
      },
      "control-phone": {
        "$value": "{fluid.text-control.phone}"
      },
      "control-wide": {
        "$value": "{fluid.text-control.wide}"
      }
    },
    "descent": {
      "$type": "number",
      "display": {
        "$value": "{font.descent.display}"
      }
    },
    "metrics": {
      "$type": "number",
      "$description": "The display face's vertical metrics in em.",
      "display-ascent": {
        "$value": "{font.metrics.display.ascent}"
      },
      "display-descender": {
        "$value": "{font.metrics.display.descender}"
      },
      "display-cap": {
        "$value": "{font.metrics.display.cap}"
      }
    },
    "separator-gap": {
      "$type": "number",
      "pipe": {
        "$value": "{font.separator-gap.pipe}"
      },
      "dot": {
        "$value": "{font.separator-gap.dot}"
      }
    }
  }
}
