    },
    "talk-style": {
      "$value": "outline"
    },
    "label-case": {
      "$value": "none"
    },
    "nav-align": {
      "$value": "end"
    },
    "menu-label": {
      "$value": "icon"
    },
    "info-layout": {
      "$value": "split"
    },
    "font-smoothing": {
      "$value": "auto"
    },
    "link-underline": {
      "$value": "always"
    }
  }
}
