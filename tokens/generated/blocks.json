      "phone": {
        "$value": "calc(100vw - 2 * clamp(1.25rem, 4vw, 7rem))"
      },
      "wide": {
        "$value": "54vw"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "beat": {
      "$value": {
        "value": 100,
        "unit": "ms"
      }
    },
    "fast": {
      "$value": {
        "value": 160,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 760,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": {
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "in": {
      "$value": [
        0.5,
        0,
        0.75,
        0
      ]
    },
    "draw": {
      "$value": [
        0.22,
        0.7,
        0.2,
        1
      ]
    },
    "pop": {
      "$value": [
        0.3,
        1.5,
        0.6,
        1
      ]
    }
  },
  "knob": {
    "$type": "string",
    "decoration": {
      "$value": "none"
    },
    "hero-figure": {
      "$value": "isometric"
    },
    "hero-layout": {
      "$value": "stack"
    },
    "hero-intro": {
      "$value": "assemble"
    },
    "nav-mode": {
